# ---------------------------------------------------------------------------
# Copy to .env and fill in real values.  .env is git-ignored: never commit it.
# The competition rules forbid shipping real credentials.
# ---------------------------------------------------------------------------

# --- MiniMax -------------------------------------------------------------
# Subscription Key from the MiniMax Token Plan (mplan).
# Mainland China account: base URL https://api.minimaxi.com/anthropic
# International account:  base URL https://api.minimax.io/anthropic
MINIMAX_API_KEY=sk-cp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3
MINIMAX_MAX_TOKENS=8192
MINIMAX_TIMEOUT=180

# --- Project record database ---------------------------------------------
# seekdb  = embedded OceanBase-derived engine (Linux/macOS, pylibseekdb)
# oceanbase = a real OceanBase tenant reached over the MySQL protocol
# sqlite = zero-dependency fallback for local development
SDD_DB_KIND=seekdb
SDD_DB_PATH=./records/sdd_pipeline
SDD_DB_HOST=127.0.0.1
SDD_DB_PORT=2881
SDD_DB_USER=root@
SDD_DB_PASSWORD=
SDD_DB_NAME=sdd_pipeline

# --- PowerContext ---------------------------------------------------------
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_TOKEN=
POWERCONTEXT_SCOPE_ID=scp_minimax_sdd_pipeline
POWERCONTEXT_ENABLED=1
